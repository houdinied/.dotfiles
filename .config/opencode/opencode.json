{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugin": [
    "./plugins/cs2-permission-reaction.js"
  ],
  "model": "vllm/qwen3.6",
  "small_model": "vllm/qwen3.6",
  "provider": {
    "vllm": {
      "id": "vllm",
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM (local)",
      "api": "http://localhost:8000/v1",
      "options": {
        "baseURL": "http://localhost:8000/v1",
        "apiKey": "EMPTY"
      },
      "models": {
        "qwen3.6": {
          "id": "qwen3.6",
          "name": "Qwen3.6 35B-A3B FP8 (express)",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  }
}
