# Omarchy integration — env vars and PATH (mirrors bash/rc)
export OMARCHY_PATH=$HOME/.local/share/omarchy
export PATH=$OMARCHY_PATH/bin:$PATH:$HOME/.local/bin
export SUDO_EDITOR="$EDITOR"
export BAT_THEME=ansi

# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(
    zsh-syntax-highlighting
    git
)
source $ZSH/oh-my-zsh.sh
PROMPT='%{$fg[cyan]%}%~%{$reset_color%} $(git_prompt_info)» '


# Omarchy aliases and functions (works in zsh)
# unalias git plugin aliases that conflict with omarchy function definitions
unalias ga gd 2>/dev/null
source ~/.local/share/omarchy/default/bash/aliases
source ~/.local/share/omarchy/default/bash/functions

# mise (replaces nvm — activates node, python, etc)
eval "$(mise activate zsh)"


# fastfetch on terminal open
fastfetch

# Aliases — docker
alias up="docker compose up --build"
alias down="docker compose down -v"
alias dev="docker compose -f docker-compose.yaml -f docker-compose.dev.yaml"

# Aliases — dev tools
alias g++='/usr/bin/g++ -std=c++17'
alias c++='/usr/bin/c++ -std=c++17'
alias ssh='TERM=xterm-256color ssh'
alias copy="wl-copy"
alias opa="omarchy-pkg-add"
alias py3="python3"
# eGPU: eject non-interactively (auto-kills Chromium's GPU holder). `command`
# avoids alias recursion so it resolves to ~/.local/bin/egpu-eject.
alias egpu-eject="command egpu-eject --yes"

# Aliases — tmux
alias tat="tmux-attach-existing"
alias ta="tmux-attach-existing"
alias trt="tmux kill-session -t"
alias tl="tmux ls"
alias td="tmux-deck"

# File colors for ls and completion menus
if command -v dircolors >/dev/null 2>&1; then
    if [ -r "$HOME/.config/dircolors" ]; then
        eval "$(dircolors -b "$HOME/.config/dircolors")"
    else
        eval "$(dircolors -b)"
    fi
fi
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

# Use plain ls instead of eza
unalias ls 2>/dev/null
alias ls='ls --color=auto'
alias ll='ls -lah --color=auto'
alias la='ls -A --color=auto'

# Show full path and ls after cd
function cd() { builtin cd "$@" && ls }

alias todo='nvim ~/mind/Zettelkasten/LIST.md'

gacp(){ git add . && git commit -m "${1:?commit message required}" && git push; }

. "$HOME/.local/share/../bin/env"

export PATH=/opt/cuda/bin:$PATH
export LD_LIBRARY_PATH=/opt/cuda/lib64:$LD_LIBRARY_PATH

# bun completions
[ -s "/home/bdepyzy/.bun/_bun" ] && source "/home/bdepyzy/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Go
export GOPATH="${XDG_DATA_HOME:-$HOME/.local/share}/go"
export GOBIN="$HOME/.local/bin"
export GOMODCACHE="${XDG_CACHE_HOME:-$HOME/.cache}/go/mod"
export GOCACHE="${XDG_CACHE_HOME:-$HOME/.cache}/go/build"
export PATH="/usr/local/go/bin:$GOBIN:$PATH"

# Keep Go builds and tools from saturating the laptop.
export GOMAXPROCS=2
export GOFLAGS="-p=2"
export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
